{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      { "include": "proto/**/*.proto", "outDir": "dist/src" },
      { "include": "proto/**/*.proto", "outDir": "dist" }
    ]
  }
}
