# ==============================================================================
# .env.example — Booking Prototipo (RDA2)
# Catálogo Autorizado de Variables de Entorno (I01–I12)
# REGLA: Cero secretos reales. Todos los campos sensibles se dejan vacíos.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración de Entorno e Infraestructura Core
# ------------------------------------------------------------------------------
# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto de escucha del servidor HTTP / REST / Swagger / BFF
PORT=3000

# Identificador único de este nodo dentro de la topología distribuida
NODE_ID=booking-gateway-01

# Cadena de conexión a base de datos PostgreSQL (con soporte de esquemas)
# Formato: postgresql://<usuario>:<password>@<host>:<puerto>/<db>?schema=public
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. Bus de Eventos Asíncronos y Mensajería Transaccional (I04)
# ------------------------------------------------------------------------------
# Modo de operación del bus de eventos: memory | rabbitmq | kafka | dual
EVENT_BUS_MODE=memory

# Cadena de conexión AMQP hacia el clúster RabbitMQ (AMQP 0-9-1)
# Formato: amqp://<usuario>:<password>@<host>:5672/<vhost>
RABBITMQ_URL=

# Lista delimitada por comas de brokers Apache Kafka
# Formato: host1:9092,host2:9092
KAFKA_BROKERS=

# Destino de eventos de telemetría y auditoría: none | kafka | memory | log
TELEMETRY_SINK=log

# ------------------------------------------------------------------------------
# 3. Orquestador de Sagas LIFO y Transacciones Compuestas (I05)
# ------------------------------------------------------------------------------
# Estrategia de persistencia del estado de sagas: memory (local/demo) | db (PostgreSQL)
SAGA_STORE=memory

# ------------------------------------------------------------------------------
# 4. Servidor Inbound gRPC de Inventario Continuo (I09)
# ------------------------------------------------------------------------------
# Habilitar servidor de ingesta gRPC en tiempo de ejecución: true | false
GRPC_ENABLED=true

# Puerto TCP de escucha para microservicio gRPC (PushStockUpdate)
GRPC_PORT=50051

# Lista delimitada por comas de API Keys autorizadas para ingesta gRPC/REST de stock
INVENTORY_API_KEYS=

# Llaves de proveedor de alojamientos
ALOJAMIENTOS_API_KEYS=

# ------------------------------------------------------------------------------
# 5. Webhooks Asimétricos Inbound con Firma HMAC-SHA256 (I06)
# ------------------------------------------------------------------------------
# Secretos compartidos para validación criptográfica (mínimo 16 caracteres cada uno)
WEBHOOK_SECRET_VUELOS=
WEBHOOK_SECRET_AUTOS=
WEBHOOK_SECRET_ATRACCIONES=
WEBHOOK_SECRET_ALOJAMIENTOS=

# Límite de peticiones por minuto para el receptor de webhooks
WEBHOOK_RATE_LIMIT_MAX=60

# ------------------------------------------------------------------------------
# 6. Pasarela de Pagos y Simulador SOA (I07)
# ------------------------------------------------------------------------------
# Habilitar simulador de pasarela cuando no hay procesador bancario activo: true | false
PAGOS_SIMULADOR_HABILITADO=false

# Modo de simulación: NORMAL | FALLO_TIEMPO_EXCEDIDO | FALLO_FONDOS_INSUFICIENTES | FALLO_RECHAZO_EMISOR
PAGOS_SIMULADOR_MODO=NORMAL

# Llaves de tiendas para autenticación de cobros directos
PAGOS_STORE_API_KEYS=

# Llave maestra perimetral para endpoints de administración y conmutación de simulador
ADMIN_SECRET_KEY=

# ------------------------------------------------------------------------------
# 7. Seguridad, Autenticación y Rate Limiting (I01)
# ------------------------------------------------------------------------------
# Habilitar limitadores de tasa perimetrales en memoria: true | false
SECURITY_RATE_LIMIT_ENABLED=true

# Permitir cabeceras técnicas de evaluación (X-Admin-Key, X-Role) en local/test: true | false
SECURITY_ALLOW_TEST_AUTH=false

# Límite máximo de peticiones por ventana de 1 minuto para endpoints de telemetría
TELEMETRY_RATE_LIMIT_MAX=60

# Límite máximo de peticiones por ventana de 1 minuto para el chatbot
CHATBOT_RATE_LIMIT_MAX=20

# ------------------------------------------------------------------------------
# 8. Logs Físicos Rotativos y Auditoría Forense (I02, I03, I08)
# ------------------------------------------------------------------------------
# Nombre del servicio estampado en cada registro JSONL
LOG_SERVICE_NAME=booking-gateway

# Emitir logs estructurados en consola además de guardarlos en disco: true | false
LOG_TO_STDOUT=false

# Días de retención para rotación y depuración automática de archivos .log
LOG_RETENTION_DAYS=14

# Directorio de almacenamiento de bitácoras físicas
LOG_DIR=logs

# ------------------------------------------------------------------------------
# 9. Conectores de Tiendas Satélites (Adaptadores ACL)
# ------------------------------------------------------------------------------
# URL base REST del servicio de atracciones / tours (Dilan Mendoza)
TIENDA_ATRACCIONES_URL=https://descubreec.com/api/v2

# URL base REST del servicio de renta de autos
TIENDA_AUTOS_URL=http://localhost:3000/api/v2/autos

# URL base REST del servicio de alojamientos / hoteles
TIENDA_ALOJAMIENTOS_URL=http://localhost:3000/api/v2/alojamientos

# URL base REST del servicio de vuelos (GDS Flight Core)
TIENDA_VUELOS_URL=http://localhost:3000/api/v2/vuelos

# ------------------------------------------------------------------------------
# 10. Servicios BaaS en la Nube (Supabase Auth / DB)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 11. Servicios Complementarios (Correo y Chatbot con LLM)
# ------------------------------------------------------------------------------
# Servidor SMTP saliente para envío de facturas digitales
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# URL base pública del frontend cliente
FRONTEND_URL=http://localhost:5173

# Proveedor de Inteligencia Artificial Groq (Chatbot de solo lectura)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING=low
